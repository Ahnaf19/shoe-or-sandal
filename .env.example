# =============================================================================
# Weather Reminder Bot Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
# Steps: Open Telegram → Search @BotFather → /newbot → Follow instructions
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (REQUIRED)
# Get it by messaging your bot, then visit:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# Look for "chat":{"id":123456789} in the JSON response
# Or use @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# -----------------------------------------------------------------------------
# Location Configuration
# -----------------------------------------------------------------------------
# Location name for display
LOCATION_NAME=Dhaka

# Coordinates (Dhaka, Bangladesh by default)
LOCATION_LATITUDE=23.8103
LOCATION_LONGITUDE=90.4125

# Timezone (IANA timezone database format)
TIMEZONE=Asia/Dhaka

# -----------------------------------------------------------------------------
# Weather Configuration
# -----------------------------------------------------------------------------
# Rain probability threshold (%) to recommend sandals (0-100)
RAIN_THRESHOLD=30

# Weather API request timeout in seconds
WEATHER_API_TIMEOUT=10

# Maximum number of API retry attempts
WEATHER_API_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to SQLite database file (for ML dataset collection)
DATABASE_PATH=weather_history.db

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format (Python logging format string)
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Optional: Log file path (leave empty to log only to console)
# LOG_FILE=weather_bot.log
